# ---- Supabase (Project Settings -> API / Database) -------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Legacy projects: JWT secret (HS256). Newer projects use asymmetric signing
# keys: leave this empty and the API verifies tokens via the project's JWKS.
SUPABASE_JWT_SECRET=
# Server-side ONLY. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=invoices
# Session-pooler or direct connection string (NOT the transaction pooler for migrations)
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# ---- Backend behaviour -------------------------------------------------------
STORAGE_BACKEND=supabase        # supabase | local
EXTRACTOR=groq                  # groq | fake
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
QUEUE_BACKEND=postgres          # postgres | celery
RUN_WORKER_IN_API=true          # postgres backend: run the worker loop inside FastAPI
REDIS_URL=redis://redis:6379/0  # only used when QUEUE_BACKEND=celery
CORS_ORIGINS=http://localhost:3000

# ---- Frontend (public values only) ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
